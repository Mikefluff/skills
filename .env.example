# AI media generation — optional execution layer (v2.2.0+)
#
# Copy this file to ~/.skills.env (or anywhere outside the repo), fill in the
# keys you actually have, then `set -a; source ~/.skills.env; set +a` in your
# shell. Or export individually in .zshrc / .bashrc.
#
# Python deps are installed automatically by install.sh into
# ~/.claude/skills/.runners-venv. To skip auto-venv: SKILLS_SKIP_VENV=1.
#
# Skills stay PROMPT-ONLY for any provider whose key is unset. There is no
# obligation to fill in every line. Pick a subset matching what you use.
#
# Provider matrix lives in:
#   image-prompt/references/execute.md
#   video-prompt/references/execute.md
#   music-prompt/references/execute.md
#
# Never commit a filled-in copy to git.

# ───────────────────────────────────────────────────────────────────────────
# LLM gateways (reused across modalities)
# ───────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=                # gpt-image-2 + Sora 2 + gpt-4o-mini-tts
OPENAI_SORA_API_ENABLED=       # set to 1 once your account has Sora API access
GEMINI_API_KEY=                # Imagen 4 / Nano Banana Pro / Lyria 3 Pro / Veo 3.1
LYRIA_API_ENABLED=             # set to 1 once your account has Lyria 3 Pro preview access
ANTHROPIC_API_KEY=             # not used by media-gen skills, listed for awareness

# ───────────────────────────────────────────────────────────────────────────
# Image / video / music providers
# ───────────────────────────────────────────────────────────────────────────
BFL_API_KEY=                   # Flux 1.1 Pro / Flux 2 Pro / Flux Kontext / Flux Schnell
FAL_KEY=                       # fal.ai cross-vendor router (Flux/Recraft/Seedream/Kling/Hunyuan/LTX-2/Wan/...)
REPLICATE_API_TOKEN=           # Replicate cross-vendor router (SD 3.5/MusicGen/...)
RUNWAY_API_KEY=                # Runway Gen-4 + Aleph + Act-One
KLING_ACCESS_KEY_ID=           # Kling video — needs BOTH access key pair
KLING_ACCESS_KEY_SECRET=
KLING_API_HOST=                # optional — override if using a regional endpoint
SUNO_API_KEY=                  # Suno music (official Pro/Premier or compatible gateway)
SUNO_API_URL=                  # optional — override base URL (default points to official Suno API)
SUNO_API_ENABLED=              # set to 1 to enable Suno calls (gate against accidental spend)
ELEVENLABS_API_KEY=            # Eleven Music + Eleven TTS
IDEOGRAM_API_KEY=              # Ideogram 3 Turbo / Default / Quality

# ───────────────────────────────────────────────────────────────────────────
# Storage (optional — local FS used if all unset)
# ───────────────────────────────────────────────────────────────────────────
# Set these to ALSO upload every generated asset to your bucket. Local copy
# always written first. URL printed alongside the local path.
S3_BUCKET=                     # bucket name
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=                     # us-east-1 / nyc3 / auto (R2) / ...
S3_ENDPOINT=                   # https://nyc3.digitaloceanspaces.com (DO Spaces)
                               # http://127.0.0.1:9000 (MinIO dev)
                               # https://<account>.r2.cloudflarestorage.com (R2)
                               # leave empty for AWS S3 default
S3_PATH_PREFIX=skills-generated  # optional prefix inside the bucket
