# AI media generation — optional execution layer (v2.2.0+)
#
# Copy this file to ~/.skills.env (or anywhere outside the repo), fill in the
# keys you actually have, then `set -a; source ~/.skills.env; set +a` in your
# shell. Or export individually in .zshrc / .bashrc.
#
# Python deps are installed automatically by install.sh into
# ~/.claude/skills/.runners-venv. To skip auto-venv: SKILLS_SKIP_VENV=1.
#
# Skills stay PROMPT-ONLY for any provider whose key is unset. There is no
# obligation to fill in every line. Pick a subset matching what you use.
#
# Provider matrix lives in:
#   skills/image-prompt/references/execute.md
#   skills/video-prompt/references/execute.md
#   skills/music-prompt/references/execute.md
#
# Never commit a filled-in copy to git.

# ───────────────────────────────────────────────────────────────────────────
# LLM gateways (reused across modalities)
# ───────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=                # gpt-image-2 + Sora 2 + gpt-4o-mini-tts
OPENAI_SORA_API_ENABLED=       # set to 1 once your account has Sora API access
GEMINI_API_KEY=                # Imagen 4 / Nano Banana Pro / Lyria 3 Pro / Veo 3.1
LYRIA_API_ENABLED=             # set to 1 once your account has Lyria 3 Pro preview access
ANTHROPIC_API_KEY=             # not used by media-gen skills, listed for awareness

# ───────────────────────────────────────────────────────────────────────────
# Image / video / music providers
# ───────────────────────────────────────────────────────────────────────────
BFL_API_KEY=                   # Flux 1.1 Pro / Flux 2 Pro / Flux Kontext / Flux Schnell
FAL_KEY=                       # fal.ai cross-vendor router (Flux/Recraft/Seedream/Kling/Hunyuan/LTX-2/Wan/...)
REPLICATE_API_TOKEN=           # Replicate cross-vendor router (SD 3.5/MusicGen/...)
RUNWAY_API_KEY=                # Runway Gen-4 + Aleph + Act-One
KLING_ACCESS_KEY_ID=           # Kling video — needs BOTH access key pair
KLING_ACCESS_KEY_SECRET=
KLING_API_HOST=                # optional — override if using a regional endpoint
SUNO_API_KEY=                  # Suno music (official Pro/Premier or compatible gateway)
SUNO_API_URL=                  # optional — override base URL (default points to official Suno API)
SUNO_API_ENABLED=              # set to 1 to enable Suno calls (gate against accidental spend)
ELEVENLABS_API_KEY=            # Eleven Music + Eleven TTS
IDEOGRAM_API_KEY=              # Ideogram 3 Turbo / Default / Quality

# ───────────────────────────────────────────────────────────────────────────
# Publishing — post-publisher (v2.21.0+)
# ───────────────────────────────────────────────────────────────────────────
#
# These are APP credentials and live here. The short-lived USER tokens they
# produce live in ~/.skills-tokens.json and are written only by the auth flow:
#
#   python3 -m common.runners.cli.auth --platform threads
#   python3 -m common.runners.cli.auth --status
#
# Never hand-edit the token file. Setup per platform (which app to register,
# which scopes, what account type is required) is in
# skills/post-publisher/references/oauth-setup.md.
#
# Start with Telegram: no OAuth, no app review, works in five minutes.

TELEGRAM_BOT_TOKEN=            # from @BotFather; the bot must be a channel ADMIN
TELEGRAM_CHAT_ID=              # @your_channel, or the numeric -100... id

THREADS_APP_ID=                # developers.facebook.com → Threads API use case
THREADS_APP_SECRET=

INSTAGRAM_APP_ID=              # Instagram API with Instagram Login (no FB Page needed)
INSTAGRAM_APP_SECRET=          # requires a Business/Creator account + S3 below

TIKTOK_CLIENT_KEY=             # developers.tiktok.com → Content Posting API
TIKTOK_CLIENT_SECRET=          # direct publishing needs app audit; --draft does not

X_CLIENT_ID=                   # developer.x.com → OAuth 2.0, incl. offline.access
X_CLIENT_SECRET=

YOUTUBE_CLIENT_ID=             # Google Cloud console → YouTube Data API v3
YOUTUBE_CLIENT_SECRET=         # 1600 quota units per upload of 10000/day

LINKEDIN_CLIENT_ID=            # linkedin.com/developers → Share on LinkedIn
LINKEDIN_CLIENT_SECRET=        # w_member_social posts as you, not as a company page

# Optional overrides — vendors deprecate on their own schedule, so the moving
# parts are env vars rather than constants. See references/platform-limits.md.
INSTAGRAM_API_VERSION=         # default v21.0
THREADS_API_VERSION=           # default v1.0
LINKEDIN_API_VERSION=          # default 202401; rejected once ~a year old
TIKTOK_PRIVACY_LEVEL=          # default PUBLIC_TO_EVERYONE
YOUTUBE_PRIVACY=               # default public; --draft forces private regardless
SKILLS_OAUTH_PORT=             # default 8723 — the loopback redirect listener

# ───────────────────────────────────────────────────────────────────────────
# Article syndication (post-publisher --kind article)
# ───────────────────────────────────────────────────────────────────────────
#
# Publish once on your own domain, then syndicate with --canonical pointing
# home. Without that flag the platform becomes the original and outranks you
# for your own words. See post-publisher/references/syndication.md.
#
# dev.to is the only one of these whose outbound links are dofollow.

DEVTO_API_KEY=                 # dev.to → Settings → Extensions → DEV Community API Keys
HASHNODE_TOKEN=                # Hashnode → Account Settings → Developer → API tokens
HASHNODE_PUBLICATION_ID=       # from the publication dashboard URL; needs Hashnode Pro to write
TELEGRAPH_ACCESS_TOKEN=        # optional — one is minted on first use and printed once
TELEGRAPH_SHORT_NAME=          # default "skills"; only shown in Telegraph's own account list
TUMBLR_ACCESS_TOKEN=           # OAuth2 token from tumblr.com/oauth/apps
TUMBLR_BLOG_ID=                # blog hostname, e.g. myblog.tumblr.com
QIITA_TOKEN=                   # Qiita → Settings → Applications; scope write_qiita
MICROPUB_ENDPOINT=             # whatever your site advertises as rel="micropub"
MICROPUB_TOKEN=                # from your IndieAuth token endpoint

# The canonical source step, for a static site generator. `cli.origin` writes the
# post and prints the URL it will have after the rebuild — that URL is what every
# --canonical downstream needs.
BLOG_CONTENT_DIR=              # e.g. ~/blog/content/posts
BLOG_URL_PATTERN=              # e.g. https://you.dev/posts/{slug}/  — must contain {slug}
BLOG_FILENAME_PATTERN=         # default {slug}.md; Jekyll: {year}-{month}-{day}-{slug}.md
BLOG_DRAFT_FIELD=              # default "draft"; empty to omit the flag entirely

# ───────────────────────────────────────────────────────────────────────────
# Storage (optional — local FS used if all unset)
# ───────────────────────────────────────────────────────────────────────────
#
# REQUIRED for Instagram, for Threads with media, and for TikTok photo posts:
# those platforms fetch media from a URL and never accept uploaded bytes.
# Files are staged as private objects and handed over as presigned links that
# expire in an hour — the bucket is never made public.
# Set these to ALSO upload every generated asset to your bucket. Local copy
# always written first. URL printed alongside the local path.
S3_BUCKET=                     # bucket name
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=                     # us-east-1 / nyc3 / auto (R2) / ...
S3_ENDPOINT=                   # https://nyc3.digitaloceanspaces.com (DO Spaces)
                               # http://127.0.0.1:9000 (MinIO dev)
                               # https://<account>.r2.cloudflarestorage.com (R2)
                               # leave empty for AWS S3 default
S3_PATH_PREFIX=skills-generated  # optional prefix inside the bucket
